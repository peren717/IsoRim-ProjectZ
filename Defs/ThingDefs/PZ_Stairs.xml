<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Stairs (decision D4, stairs design §1): a 1x3 ramp, turned by its rotation (it goes up toward the way it faces).
       The floor above stays open over it (the stairwell); the cell past its top on the floor above is the exit (the landing),
       laid with the stairs where it is open air and taken away with them. Stairs hold roofs and floors up like a wall
       (removal design §7), so they can stand anywhere. Everyone can use them (D9). IsoRim draws its model
       (IsoRim/Defs/PZ_Models.xml); the sprite is the plain fallback. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PZ_Stairs</defName>
    <label>stairs</label>
    <description>Stairs up to the floor above. The floor above stays open over them; the cell past the top is the landing on the floor above, built with the stairs. Like a wall, stairs hold up roofs and floors nearby.</description>
    <thingClass>ProjectZ.Building_Stairs</thingClass>
    <graphicData>
      <texPath>ProjectZ/Stairs</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,3)</drawSize>
    </graphicData>
    <uiIconPath>ProjectZ/Stairs_MenuIcon</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>8</pathCost>
    <fillPercent>0.25</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <holdsRoof>true</holdsRoof>
    <blockWind>false</blockWind>
    <rotatable>true</rotatable>
    <size>(1,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <designationCategory>Structure</designationCategory>
    <placeWorkers>
      <li>ProjectZ.PlaceWorker_Stairs</li>
    </placeWorkers>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <uiOrder>2900</uiOrder>
  </ThingDef>

</Defs>
