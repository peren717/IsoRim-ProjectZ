<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Stairs (decision D4, stairs design §1): a 1x3 ramp, turned by its rotation (it goes up toward the way it faces).
       The floor above stays open over it (the stairwell); the cell past its top on the floor above is the exit, made with
       the stairs when it is open air over a roofed cell. Everyone can use them (D9). IsoRim draws its model
       (IsoRim/Defs/PZ_Models.xml); the sprite is the plain fallback. -->
  <ThingDef ParentName="BuildingBase">
    <defName>PZ_Stairs</defName>
    <label>stairs</label>
    <description>Stairs up to the floor above. The floor above stays open over them; the cell past the top is the exit on the floor above (made with the stairs if it has a roof under it).</description>
    <thingClass>ProjectZ.Building_Stairs</thingClass>
    <graphicData>
      <texPath>ProjectZ/Stairs</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,3)</drawSize>
    </graphicData>
    <uiIconPath>ProjectZ/Stairs</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>8</pathCost>
    <fillPercent>0.25</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <holdsRoof>false</holdsRoof>
    <blockWind>false</blockWind>
    <rotatable>true</rotatable>
    <size>(1,3)</size>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <designationCategory>Structure</designationCategory>
    <placeWorkers>
      <li>ProjectZ.PlaceWorker_Stairs</li>
    </placeWorkers>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <uiOrder>2900</uiOrder>
  </ThingDef>

</Defs>
