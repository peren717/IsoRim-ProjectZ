<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The roof of a cell with an upper floor over it (M1c, decision D6): the floor itself. Thin, never collapses; it can't
       be removed while the floor is there (FloorRoof.cs). Removing the floor turns it back into a constructed roof. -->
  <RoofDef>
    <defName>PZ_FloorRoof</defName>
    <label>upper floor</label>
    <isThickRoof>false</isThickRoof>
    <canCollapse>false</canCollapse>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundPunchThrough>PunchThroughRoofMetal</soundPunchThrough>
  </RoofDef>

  <!-- The roof over stairs (stairs design §1, Q1): keeps the room under the stairwell indoors, is never drawn (IsoRim
       Api.HiddenRoof) and counts as open for jumps, sight and falling shots (Column.OpenAbove). Set and cleared only by
       the stairwell rule (Stairs.cs, Stairwell.RoofFor). -->
  <RoofDef>
    <defName>PZ_StairwellRoof</defName>
    <label>stairwell</label>
    <isThickRoof>false</isThickRoof>
    <canCollapse>false</canCollapse>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <soundPunchThrough>PunchThroughRoofMetal</soundPunchThrough>
  </RoofDef>

</Defs>
