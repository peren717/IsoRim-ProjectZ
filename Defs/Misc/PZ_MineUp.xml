<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Tall mountains, vertical mining: two commands next to vanilla Mine (ProjectZ.Designator_MineAbove / _MineBelow,
       Patches/PZ_MineVertical.xml). The player marks cells of the viewed level; the mark (a cell designation on that cell)
       fixes the side. Mine above: the rock right above is mined from that cell (its floor opens: mine up,
       ProjectZ.WorkGiver_MineFromBelow). Mine below: the rock right below is mined from beside that cell (the cell opens:
       mine down, ProjectZ.WorkGiver_MineFromAbove). Vanilla Mine stays vanilla. -->
  <DesignationDef>
    <defName>PZ_MineAbove</defName>
    <texturePath>Designations/Mine</texturePath>
    <targetType>Cell</targetType>
  </DesignationDef>

  <DesignationDef>
    <defName>PZ_MineBelow</defName>
    <texturePath>Designations/Mine</texturePath>
    <targetType>Cell</targetType>
  </DesignationDef>

  <JobDef>
    <defName>PZ_MineFromBelow</defName>
    <driverClass>ProjectZ.JobDriver_MineFromBelow</driverClass>
    <reportString>digging at TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <WorkGiverDef>
    <defName>PZ_MineFromBelow</defName>
    <label>mine from below</label>
    <giverClass>ProjectZ.WorkGiver_MineFromBelow</giverClass>
    <workType>Mining</workType>
    <priorityInType>99</priorityInType>
    <scanThings>false</scanThings>
    <scanCells>true</scanCells>
    <verb>mine</verb>
    <gerund>mining</gerund>
    <tagToGive>Fieldwork</tagToGive>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <JobDef>
    <defName>PZ_MineFromAbove</defName>
    <driverClass>ProjectZ.JobDriver_MineFromAbove</driverClass>
    <reportString>digging at TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <WorkGiverDef>
    <defName>PZ_MineFromAbove</defName>
    <label>mine from above</label>
    <giverClass>ProjectZ.WorkGiver_MineFromAbove</giverClass>
    <workType>Mining</workType>
    <priorityInType>98</priorityInType>
    <scanThings>false</scanThings>
    <scanCells>true</scanCells>
    <verb>mine</verb>
    <gerund>mining</gerund>
    <tagToGive>Fieldwork</tagToGive>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
