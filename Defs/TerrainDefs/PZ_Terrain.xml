<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Empty annex cell: the space where an upper floor can go. Impassable, not drawn; only an upper floor can be built on it. -->
  <TerrainDef>
    <defName>PZ_OpenAir</defName>
    <label>open air</label>
    <description>Empty space on an upper floor. Lay an upper floor here near walls or columns below.</description>
    <dontRender>true</dontRender>
    <passability>Impassable</passability>
    <pathCost>300</pathCost>
    <fertility>0</fertility>
    <edgeType>Hard</edgeType>
    <renderPrecedence>300</renderPrecedence>
    <layerable>false</layerable>
    <changeable>true</changeable>
    <holdSnowOrSand>false</holdSnowOrSand>
    <avoidWander>true</avoidWander>
    <preventCraters>true</preventCraters>
    <canEverTerraform>false</canEverTerraform>
    <supportsRock>false</supportsRock>
    <canBePolluted>false</canBePolluted>
    <takeFootprints>false</takeFootprints>
    <filthAcceptanceMask>
      <li>None</li>
    </filthAcceptanceMask>
    <statBases>
      <WorkToBuild>0</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <affordances>
      <li>PZ_FloorSupport</li>
    </affordances>
  </TerrainDef>

  <!-- An upper floor cell (M1b): built on open air where a roof could be held below (PlaceWorker_UpperFloor, decision D6 as
       changed by the removal design §7), taken up with the remove-foundation tool (Slabs.cs). Walkable; walls,
       furniture and normal floors can go on it. A beam lattice (redesign §9; a floor laid on it hides the lattice), made of
       any Woody, Metallic or Stony stuff: one slab def per stuff, like the game's stone tiles, in one build-menu dropdown.
       This def is the wood slab (the defName older saves have). SlabDefs.cs makes the others from it at load, for every
       such stuff incl. modded ones, and sets each one's label, colour, icon colour, cost (4 of the stuff) and work (300,
       scaled by the stuff like a wall's). Not flammable, even wood (§9). -->
  <TerrainDef>
    <defName>PZ_UpperFloor</defName>
    <label>upper floor</label>
    <description>A grid of beams for the storey above. View the floor above, then lay it where a roof could go: near walls, columns or stairs below. Removing it returns no materials.</description>
    <texturePath>ProjectZ/Terrain/SlabLattice</texturePath>
    <uiIconPath>ProjectZ/UpperFloor_MenuIcon</uiIconPath>
    <cropIcon>false</cropIcon>
    <designatorDropdown>PZ_UpperFloors</designatorDropdown>
    <edgeType>Hard</edgeType>
    <renderPrecedence>250</renderPrecedence>
    <layerable>false</layerable>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Walkable</li>
    </affordances>
    <tags>
      <li>Floor</li>
    </tags>
    <designationCategory>Structure</designationCategory>
    <drawStyleCategory>Floors</drawStyleCategory>
    <terrainAffordanceNeeded>PZ_FloorSupport</terrainAffordanceNeeded>
    <placeWorkers>
      <li>ProjectZ.PlaceWorker_UpperFloor</li>
    </placeWorkers>
    <pathCost>0</pathCost>
    <fertility>0</fertility>
    <constructEffect>ConstructWood</constructEffect>
    <canEverTerraform>false</canEverTerraform>
    <supportsRock>false</supportsRock>
    <!-- A heavy hit (SlabDamage): an explosion doing at least this much damage at the cell. Wood slabs break, stone and
         metal ones become damaged slabs, damaged ones break. The vanilla bridge value: frag grenades and mortar shells reach it.
         Every generated slab inherits it, except armoured metal slabs (SlabDefs.Armored: 55). -->
    <destroyOnBombDamageThreshold>35</destroyOnBombDamageThreshold>
    <preventCraters>true</preventCraters>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <WoodLog>4</WoodLog>
    </costList>
  </TerrainDef>

  <DesignatorDropdownGroupDef>
    <defName>PZ_UpperFloors</defName>
    <label>upper floor</label>
  </DesignatorDropdownGroupDef>

</Defs>
