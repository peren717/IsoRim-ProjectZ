<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 (Waylith) build: net10 + Harmony 3.0, against the game-root Assembly-CSharp (as IsoRim17's IsoRim.csproj). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>IsoRimProjectZ</AssemblyName>
    <RootNamespace>ProjectZ</RootNamespace>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <!-- IsoRim with the floor API (branch projectz-api until merged): override with -p:IsoRimDll=... -->
    <IsoRimDll Condition="'$(IsoRimDll)' == ''">..\..\IsoRimModelsWT\1.7\Assemblies\IsoRim.dll</IsoRimDll>
    <!-- The game folder (default: this repo sits in its Mods folder); override with -p:RimDir=... for a worktree elsewhere. -->
    <RimDir Condition="'$(RimDir)' == ''">..\..\..</RimDir>
    <DefineConstants>$(DefineConstants);RW17</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="IsoRim"><HintPath>$(IsoRimDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RimDir)\..\..\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
