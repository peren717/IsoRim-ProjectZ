<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim's model of the stairs (loaded only with IsoRim, LoadFolders.xml; 1x4 model 2026-10-21, user-approved): one
       closed solid of the stairs' stuff on the 1x4 footprint, 6 equal risers (storey 1.67 / 6) over the 3 ramp cells with
       the treads centred on the walk ramp (Jumps.RampRise), so a pawn's feet sit on the treads; the solid 4th cell under
       the exit ends just under the floor slab IsoRim draws there (1.54), so the slab is the landing. Treads, sides and back
       plain "stuff" so the stairs read like walls of the same stuff, risers "stuff_dark", the hidden bottom "stuff_deep".
       Written by tools/projectz/stairs1x4_blender.py (supersedes stairs_obj.js). -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Stairs</defName>
    <thingDef>PZ_Stairs</thingDef>
    <model>Models/pz_stairs.obj</model>
    <builtFor>(1, 4)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

  <!-- The ship stairs (multi-level gravships P5): the same stairs model (pz_ship_stairs.obj = pz_stairs.obj with its materials
       and texture coordinates changed, tools/projectz/ship_stairs_obj.js, regenerated from the 1x4 model 2026-10-21) with a
       ship texture: gravship plating, dark seams, cyan strips along both sides and at the landing edge. Fixed colours (stuffless). -->
  <IsoRim.ModelDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>R3D_PZ_ShipStairs</defName>
    <thingDef>PZ_ShipStairs</thingDef>
    <model>Models/pz_ship_stairs.obj</model>
    <builtFor>(1, 4)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

  <!-- The elevator's base (Grok 2026-10-20, user-approved): the shaft's first storey, an open steel frame with its door
       side to the north as modelled (the game turns it to the elevator's rotation), a floor plate and a machine box.
       Fixed colours (pz_lifts.mtl). The shaft segments over it, its top piece and the rider's platform are drawn each
       frame (Source/LiftModels.cs, ElevatorDraw); the base is a storey tall, which HeightRule leaves to the shaft rules. -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Elevator</defName>
    <thingDef>PZ_Elevator</thingDef>
    <model>Models/pz_elevator_base.obj</model>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

</Defs>
