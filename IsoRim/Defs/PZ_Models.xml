<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim's model of the stairs (loaded only with IsoRim, LoadFolders.xml): a stepped ramp up to one storey at the
       locked wall height (1.65 + 0.02). Big plain shapes; treads light, risers darker. -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Stairs</defName>
    <thingDef>PZ_Stairs</thingDef>
    <model>Models/pz_stairs.obj</model>
    <builtFor>(1, 3)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

</Defs>
