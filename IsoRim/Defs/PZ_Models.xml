<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim's model of the stairs (loaded only with IsoRim, LoadFolders.xml): a stepped ramp up to one storey at the
       locked wall height (1.65 + 0.02) and, since 2026-10-20, a plain block on the solid 4th cell under the exit
       (placeholder; built for 1x4). Big plain shapes with box-projected UVs; treads, sides and back plain "stuff" so
       the stairs read like walls of the same stuff, risers "stuff_dark", the hidden bottom "stuff_deep". No plate over the
       exit cell: the landing is drawn as the floor laid there (bare slab, carpet, wood), like any floor cell. Written by
       tools/projectz/stairs_obj.js (landing=0, solid=1). -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Stairs</defName>
    <thingDef>PZ_Stairs</thingDef>
    <model>Models/pz_stairs.obj</model>
    <builtFor>(1, 4)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

  <!-- The ship stairs (multi-level gravships P5): the same stairs model (pz_ship_stairs.obj = pz_stairs.obj with its materials
       and texture coordinates changed, tools/projectz/ship_stairs_obj.js) with a ship texture: gravship plating, dark
       seams, cyan strips along both sides and at the landing edge. Fixed colours (stuffless). -->
  <IsoRim.ModelDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>R3D_PZ_ShipStairs</defName>
    <thingDef>PZ_ShipStairs</thingDef>
    <model>Models/pz_ship_stairs.obj</model>
    <builtFor>(1, 4)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

  <!-- The elevator's base (Grok 2026-10-20, user-approved): the shaft's first storey, an open steel frame with its door
       side to the north as modelled (the game turns it to the elevator's rotation), a floor plate and a machine box.
       Fixed colours (pz_lifts.mtl). The shaft segments over it, its top piece and the rider's platform are drawn each
       frame (Source/LiftModels.cs, ElevatorDraw); the base is a storey tall, which HeightRule leaves to the shaft rules. -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Elevator</defName>
    <thingDef>PZ_Elevator</thingDef>
    <model>Models/pz_elevator_base.obj</model>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

</Defs>
