<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- IsoRim's model of the stairs (loaded only with IsoRim, LoadFolders.xml): a stepped ramp up to one storey at the
       locked wall height (1.65 + 0.02). Big plain shapes with box-projected UVs; treads, sides and back plain "stuff" so
       the stairs read like walls of the same stuff, risers "stuff_dark", the hidden bottom "stuff_deep". The top step runs on
       over the exit cell as the landing plate (just outside the floor slab IsoRim draws there, so it hides it), so ramp and
       landing read as one piece; the footprint stays 1x3. Written by tools/projectz/stairs_obj.js. -->
  <IsoRim.ModelDef>
    <defName>R3D_PZ_Stairs</defName>
    <thingDef>PZ_Stairs</thingDef>
    <model>Models/pz_stairs.obj</model>
    <builtFor>(1, 3)</builtFor>
    <groundShadow>false</groundShadow>
  </IsoRim.ModelDef>

</Defs>
